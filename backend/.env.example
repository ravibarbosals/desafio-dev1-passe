# API
APP_PORT=3000
CORS_ORIGIN=http://localhost:5173

# Banco (PostgreSQL do docker compose)
DATABASE_HOST=localhost
DATABASE_PORT=5435
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=passe
# Opcional: certificado da CA do banco (PEM). Com ele, a conexão usa SSL e verifica o servidor (produção, DEC-073)
# DATABASE_SSL_CA=

# dbmate (migrations)
DATABASE_URL=postgres://postgres:postgres@localhost:5435/passe?sslmode=disable
DBMATE_NO_DUMP_SCHEMA=true
