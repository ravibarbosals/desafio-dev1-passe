    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.18",
    "@types/express": "^5.0.0",
    "@types/node": "^22.20.5",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "typescript": "^5.7.3",
    "unplugin-swc": "^2.0.0",
