{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript"],
  "env": {
    "node": true,
    "es2024": true
  },
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": ["dist/**", "coverage/**", "node_modules/**"],
  "rules": {
    "no-debugger": "error",
    "no-var": "error",
    "no-void": ["error", { "allowAsStatement": true }],
    "yoda": "error",
    "prefer-arrow-callback": "error",
    "default-param-last": "error",
    "max-nested-callbacks": ["error", { "max": 4 }],
    "typescript/no-duplicate-enum-values": "error",
    "typescript/no-use-before-define": "error",
    "typescript/no-require-imports": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/await-thenable": "error",
    "no-console": "warn",
    "no-empty-function": "warn",
    "curly": "warn",
    "no-else-return": "warn",
    "no-nested-ternary": "warn",
    "prefer-template": "warn",
    "no-useless-catch": "warn",
    "no-control-regex": "warn",
    "no-unsafe-finally": "warn",
    "no-shadow": "warn",
    "max-lines": ["warn", { "max": 1000, "skipBlankLines": false, "skipComments": false }],
    "max-lines-per-function": ["warn", { "max": 200, "skipBlankLines": false, "skipComments": false }],
    "max-statements": ["warn", { "max": 50 }],
    "no-unused-vars": ["warn", { "args": "none", "caughtErrors": "none", "ignoreRestSiblings": true, "varsIgnorePattern": "^_" }],
    "typescript/no-explicit-any": "warn"
  },
  "overrides": [
    {
      "files": ["**/*.spec.ts"],
      "rules": {
        "max-lines": "off",
        "max-lines-per-function": "off",
        "max-statements": "off",
        "typescript/no-explicit-any": "off"
      }
    }
  ]
}
